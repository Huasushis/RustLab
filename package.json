{
  "name": "rustlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "面向有编程基础者的 Rust 闯关式在线教程（纯静态，可部署到 Cloudflare Pages）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-content.ts",
    "runner": "node runner/server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dompurify": "^3.4.17",
    "marked": "^18.2.0",
    "monaco-editor": "0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
